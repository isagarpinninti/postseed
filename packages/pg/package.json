{
  "name": "@postseed/pg",
  "version": "0.1.0",
  "description": "Node-only PostgreSQL layer for Postseed: pg_catalog introspection, a transactional inserter with dry run, and local connection history.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Sagar Pinninti",
    "url": "https://github.com/isagarpinninti"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isagarpinninti/postseed.git",
    "directory": "packages/pg"
  },
  "homepage": "https://github.com/isagarpinninti/postseed#readme",
  "bugs": {
    "url": "https://github.com/isagarpinninti/postseed/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "seed",
    "introspection",
    "fixtures",
    "pg_catalog"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@postseed/core": "workspace:*",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "tsup": "^9.0.0"
  }
}
