{
  "name": "postseed-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Realistic, relationship-correct seed data for PostgreSQL. Local-first and deterministic.",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "turbo run test",
    "e2e": "pnpm --filter postseed run e2e && pnpm --filter @postseed/web exec playwright test",
    "gates": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm e2e && pnpm smoke",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "bench": "pnpm --filter @postseed/core run bench",
    "smoke": "node scripts/smoke.mjs",
    "bundle:launchers": "node scripts/bundle-launchers.mjs"
  },
  "license": "MIT",
  "author": {
    "name": "Sagar Pinninti",
    "url": "https://github.com/isagarpinninti"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isagarpinninti/postseed.git"
  },
  "homepage": "https://github.com/isagarpinninti/postseed#readme",
  "bugs": {
    "url": "https://github.com/isagarpinninti/postseed/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
